{
  "name": "@yuppers/verify",
  "version": "0.1.0",
  "description": "Checks that an exported Yuppers record's history was publicly timestamped: the hash chain, the daily Merkle tree, the OpenTimestamps proof and the RFC 3161 token.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "yuppers-verify": "./bin/yuppers-verify.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yuppers-LLC/yuppers-verify.git"
  },
  "homepage": "https://github.com/Yuppers-LLC/yuppers-verify#readme",
  "bugs": {
    "url": "https://github.com/Yuppers-LLC/yuppers-verify/issues"
  },
  "files": [
    "src",
    "dist",
    "bin",
    "LICENSE",
    "README.md",
    "FORMAT.md"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "asn1js": "^3.0.6",
    "pkijs": "^3.2.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
